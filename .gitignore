# Root .gitignore for P0021-AutoVideo-Studio
# Specific per-folder ignores live in app/.gitignore and worker/.gitignore.

# Node
node_modules/
.next/
.next-verify/
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.pyc

# Worker storage (jobs, preview cache, test assets)
.runtime/
worker/storage/jobs/
worker/storage/preview/
worker/storage/smoke/
worker/storage/smoke_images/
worker/storage/test-assets/*.mp3
worker/storage/test-assets/*.mp4
worker/storage/test-assets/*.jpg

# Reference repos (cloned for inspiration, not part of project)
_reference/

# Env + secrets
.env
.env.local
.env*.local
.vercel/
app/.vercel/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
