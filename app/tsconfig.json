{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tool-workspace/hub-ui": ["./vendor/hub-ui/src/index.ts"],
      "@tool-workspace/hub-ui/*": ["./vendor/hub-ui/src/*"],
      "@tool-workspace/hub-identity": ["./vendor/hub-identity/src/index.ts"],
      "@tool-workspace/hub-identity/*": ["./vendor/hub-identity/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "vendor"]
}
