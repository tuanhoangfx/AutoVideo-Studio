{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tool-workspace/hub-ui": ["./vendor/hub-ui/src/index.ts"],
      "@tool-workspace/hub-ui/*": ["./vendor/hub-ui/src/*"],
      "@tool-workspace/hub-identity": ["./vendor/hub-identity/src/index.ts"],
      "@tool-workspace/hub-identity/*": ["./vendor/hub-identity/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "vendor", "vite.config.ts"]
}
