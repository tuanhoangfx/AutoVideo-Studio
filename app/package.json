{
  "name": "autovideo-studio",
  "version": "2.2.131",
  "private": true,
  "description": "AutoVideo Studio desktop app with local render worker.",
  "author": "TuanHoangFX",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node ../../scripts/gate.mjs --code P0021 --stage sync",
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3021",
    "dev:sync": "node ../../scripts/gate.mjs --code P0021 --stage sync && node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3021",
    "sync": "node ../../scripts/gate.mjs --code P0021 --stage sync",
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/build.mjs --desktop",
    "build:vercel": "node scripts/build.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4021",
    "desktop": "electron electron/main.cjs",
    "desktop:dev": "powershell -ExecutionPolicy Bypass -File ../scripts/start-desktop-dev.ps1",
    "desktop:worker": "powershell -ExecutionPolicy Bypass -File ../scripts/build-worker-exe.ps1",
    "desktop:prepare": "powershell -ExecutionPolicy Bypass -File ../scripts/prepare-desktop-build.ps1",
    "desktop:verify-ui": "node ../scripts/verify-ui-lane.mjs --probe",
    "desktop:dist:fast": "node ../scripts/run-desktop-dist-fast.mjs",
    "desktop:dir": "node ../scripts/run-desktop-dist-fast.mjs",
    "desktop:open": "node ../scripts/desktop-open.mjs",
    "desktop:dist": "node ../../scripts/run-script-chain.cjs -- pnpm desktop:worker -- pnpm desktop:prepare -- electron-builder --win nsis --x64 --publish never",
    "desktop:release": "powershell -ExecutionPolicy Bypass -File ../scripts/release-desktop.ps1",
    "desktop:release:patch": "pnpm desktop:release -- -Bump patch -Publish",
    "desktop:release:minor": "pnpm desktop:release -- -Bump minor -Publish",
    "desktop:release:major": "pnpm desktop:release -- -Bump major -Publish",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "test": "vitest run",
    "test:worker": "powershell -ExecutionPolicy Bypass -File ../scripts/test-worker-smoke.ps1",
    "smoke:auth": "node ../scripts/smoke-p0021-login-resolve.mjs"
  },
  "dependencies": {
    "@tool-workspace/hub-ui": "file:./vendor/hub-ui",
    "@tool-workspace/hub-identity": "file:./vendor/hub-identity",
    "@supabase/auth-js": "2.106.1",
    "@supabase/functions-js": "2.106.1",
    "@supabase/postgrest-js": "2.106.1",
    "@supabase/realtime-js": "2.106.1",
    "@supabase/storage-js": "2.106.1",
    "@supabase/supabase-js": "^2.106.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.561.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.9.1",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "vn.infix1.autovideo-studio",
    "productName": "AutoVideo Studio",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../worker/dist/autovideo-worker",
        "to": "worker-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tuanhoangfx",
        "repo": "AutoVideo-Studio",
        "releaseType": "release"
      }
    ]
  }
}
